        return response()->json(['status' => 'error', 'message' => 'Session key missing'], 400);
    }
    
    $previewData = session($sessionKey);
    
    if (!$previewData) {
        return response()->json(['status' => 'error', 'message' => 'Preview data expired'], 400);
    }
    
    $franchiseId = Franchise::getFranchiseId();
    $franchise = Franchise::findOrFail($franchiseId);
    $barcodeOption = $previewData['barcode_option'] ?? 'barcode_auto';
    $bulkBatchId = $previewData['bulk_batch_id'] ?? null;
    $isSpecialFranchise = $previewData['is_special_franchise'] ?? false;
    
    \Log::info("Processing with Bulk Batch ID: {$bulkBatchId}");
    \Log::info("Special Franchise: " . ($isSpecialFranchise ? 'Yes' : 'No'));
    
    // BARCODE AVAILABILITY CHECK
    if ($barcodeOption === 'barcode_auto') {
        $availableCount = $this->getBarcodeAvailableCount();
        $requiredCount = count($previewData['success_rows']);
        
        \Log::info("Barcode check - Available: {$availableCount}, Required: {$requiredCount}");
        
        if ($availableCount < $requiredCount) {
            return response()->json([
                'status' => 'error',
                'message' => "Insufficient barcodes. Available: {$availableCount}, Required: {$requiredCount}"
            ], 400);
        }
    }
    
    // Get franchise series details
    $franchiseSeriesDetails = FranchiseBarcodeSeries::where("franchise_id", $franchiseId)->first();
    
    // Get service type value
    $serviceTypeValue = IndiaPostSpeedPostParcel::getServiceTypeDB(IndiaPostSpeedPostParcel::SERVICE_TYPE_INDIA_POST_SPEED);
    $last_code_issued_column = "last_parcel_code_issued_{$serviceTypeValue}";
    $range_start_column = "parcel_barcode_range_start_{$serviceTypeValue}";
    $range_end_column = "parcel_barcode_range_end_{$serviceTypeValue}";
    
    // Track barcode start
    $startBarcode = 0;
    if ($barcodeOption === 'barcode_auto' && $franchiseSeriesDetails) {
        $startBarcode = (int)($franchiseSeriesDetails->{$last_code_issued_column} ?? 0);
        $rangeStart = (int)($franchiseSeriesDetails->{$range_start_column} ?? 0);
        
        if ($startBarcode === 0 || $startBarcode < $rangeStart) {
            $startBarcode = $rangeStart - 1;
        }
        
        \Log::info("Starting barcode from: {$startBarcode}");
    }
    
    DB::beginTransaction();
    
    try {
        $successCount = 0;
        $failCount = 0;
        $failedRows = [];
        $createdParcelIds = [];
        $totalPaymentAmount = 0;
        
        // Process each success row from preview
        foreach ($previewData['success_rows'] as $index => $rowData) {
            try {
                $element = $rowData['data'];
                $srNo = $rowData['excel_sr_no'] ?? $element["sr no"] ?? ($index + 1);
                $weight = $rowData['calculated_weight'] ?? floatval($element["Package Weight"] ?? 0);
                
                // 🔴 STOREBYFILE की तरह DISTANCE और SOURCE use करें
                $distance = $rowData['distance_used'] ?? null;
                $distanceSource = $rowData['distance_source'] ?? null;
                $origin = trim($element["Pickup Pincode"] ?? '');
                
                \Log::info("Processing row {$srNo}: Distance={$distance}km, Source={$distanceSource}, Weight={$weight}g");
                
                // 🔴 DISTANCE के आधार पर PRICE CALCULATE करें
                if (!$distance) {
                    throw new \Exception("Distance not available for row {$srNo}");
                }
                
                // Price calculate करें - storeByFile की तरह
                $priceResult = $this->calculatePriceWithDistanceAndWeight($origin, $distance, $weight);
                
                if ($priceResult['status'] !== 'success') {
                    throw new \Exception($priceResult['message'] ?? "Price calculation failed for row {$srNo}");
                }
                
                $basePrice = $priceResult['price'];
                $gst = $priceResult['gst'];
                $totalPrice = $priceResult['total'];
                
                // Additional charges
                $fuel_charge = floatval($element["Fuel Charge"] ?? 0);
                $pickup_charge = floatval($element["Pickup Charge"] ?? 0);
                $other_service_charge = floatval($element["Other service Charge"] ?? 0);
                $register_amount = floatval($element["Register Fee"] ?? 0);
                
                $additionalCharges = $fuel_charge + $pickup_charge + $other_service_charge + $register_amount;
                $payment_amount = $totalPrice + $additionalCharges;
                
                \Log::info("Price for row {$srNo}: Base={$basePrice}, GST={$gst}, Total={$totalPrice}, Additional={$additionalCharges}, Final={$payment_amount}");
                
                // Generate barcode
                $code = null;
                if ($barcodeOption === "barcode_custom") {
                    $code = trim($element["Barcode"] ?? '');
                    if (empty($code)) {
                        throw new \Exception('Custom barcode is missing');
                    }
                    
                    $existingParcel = IndiaPostSpeedPostParcel::where("barcode_no", $code)
                                ->where("franchise_id", $franchiseId)
                                ->whereDate("created_at", Carbon::today())
                                ->exists();
                    if ($existingParcel) {
                        throw new \Exception("Barcode $code already used today");
                    }
                } else {
                    // Auto generate barcode
                    $startBarcode++;
                    
                    $rangeEnd = (int)($franchiseSeriesDetails->{$range_end_column} ?? 0);
                    if ($startBarcode > $rangeEnd) {
                        throw new \Exception("Barcode series exhausted");
                    }
                    
                    $code = $this->getNextBarcode();
                    \Log::info("Generated barcode: {$code} for row {$srNo}");
                }
                
                // Balance check
                $indiapost_balance = (float)$franchise->indiapost_balance;
                $credit_balance = (float)$franchise->india_credit_amount;
                $totalBalance = $indiapost_balance + $credit_balance;
                
                if ($totalBalance < $payment_amount) {
                    throw new \Exception("Insufficient balance. Required: {$payment_amount}, Available: {$totalBalance}");
                }
                
                // Resolve customer
                $customer = $this->resolveCustomer($element, $franchiseId);
                $bookingType = $this->determineBookingTypeFromCustomer($customer);
                
                // Generate barcode image
                $generator = new BarcodeGeneratorPNG();
                $barcode_img = base64_encode($generator->getBarcode($code, $generator::TYPE_CODE_128));
                
                // Create parcel
                $parcelData = [
                    "franchise_id" => $franchiseId,
                    "franchise_role_users_id" => Auth::guard('franchiseRoleUser')->check() ? 
