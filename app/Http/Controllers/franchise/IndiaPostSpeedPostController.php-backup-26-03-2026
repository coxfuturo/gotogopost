   public function getBarcodeAvailableCount()
{
    $serviceType = IndiaPostSpeedPostParcel::SERVICE_TYPE_INDIA_POST_SPEED;
    
    // service type value
    $serviceTypeValue = IndiaPostSpeedPostParcel::getServiceTypeDB($serviceType);
    
    $range_start_column = "parcel_barcode_range_start_{$serviceTypeValue}";
    $range_end_column = "parcel_barcode_range_end_{$serviceTypeValue}";
    $last_code_issued_column = "last_parcel_code_issued_{$serviceTypeValue}";
    
    $franchiseId = Franchise::getFranchiseId();
    
    // Debugging
    \Log::info("Checking barcode availability for franchise: {$franchiseId}");
    \Log::info("Service Type: {$serviceType}, DB Value: {$serviceTypeValue}");
    \Log::info("Columns - Start: {$range_start_column}, End: {$range_end_column}, Last: {$last_code_issued_column}");
    
    $franchiseSeriesDetails = FranchiseBarcodeSeries::where("franchise_id", $franchiseId)->first();
    
    if (!$franchiseSeriesDetails) {
        \Log::warning("No barcode series found for franchise: {$franchiseId}");
        return 0;
    }
    
    \Log::info("Franchise series details:", [
        'start' => $franchiseSeriesDetails->{$range_start_column},
        'end' => $franchiseSeriesDetails->{$range_end_column},
        'last_issued' => $franchiseSeriesDetails->{$last_code_issued_column},
    ]);
    
    $start = (int) ($franchiseSeriesDetails->{$range_start_column} ?? 0);
    $end = (int) ($franchiseSeriesDetails->{$range_end_column} ?? 0);
    $lastIssued = (int) ($franchiseSeriesDetails->{$last_code_issued_column} ?? 0);
    
    if ($lastIssued === 0) {
        $lastIssued = $start - 1;
    }
    
    $available = max(0, $end - $lastIssued);
    
    \Log::info("Barcode availability calculation: Start={$start}, End={$end}, LastIssued={$lastIssued}, Available={$available}");
    
    return $available;
}
     public function index(Request $request, RateCalculator $rateCalculator)
{
    $totalParcels = 0;
    $totalAmount = 0;
    $CodtotalAmount = 0;
    $type = $request->type;
    $searchKey = $request->input("searchKey");
    
    $fromdate = $request->input("fromdate");
    $todate = $request->input("todate");
    $franchise = Franchise::getFranchiseId();

    // Main query
    $query = IndiaPostSpeedPostParcel::where("franchise_id", Franchise::getFranchiseId())
        ->where("status", 0)
       ->orderBy("bulk_batch_id", "ASC")    
        ->orderBy("excel_row_no", "ASC");  

    if ($request->type == "cod") {
        $query->where("payment_method", "cod");
    } else {
        $query->where("payment_method", "prepaid");
    }

    if ($searchKey) {
        $query->where(function ($q) use ($searchKey) {
            $q->where("pickup_name", "LIKE", "%{$searchKey}%")
                ->orWhere("pickup_mobile", "LIKE", "%{$searchKey}%")
                ->orWhere("pickup_email", "LIKE", "%{$searchKey}%")
                ->orWhere("pickup_pincode", "LIKE", "%{$searchKey}%")
                ->orWhere("pickup_city", "LIKE", "%{$searchKey}%")
                ->orWhere("pickup_state", "LIKE", "%{$searchKey}%")
                ->orWhere("pickup_address", "LIKE", "%{$searchKey}%")
                ->orWhere("consignee_name", "LIKE", "%{$searchKey}%")
                ->orWhere("consignee_mobile", "LIKE", "%{$searchKey}%")
                ->orWhere("consignee_email", "LIKE", "%{$searchKey}%")
                ->orWhere("consignee_pincode", "LIKE", "%{$searchKey}%")
                ->orWhere("consignee_city", "LIKE", "%{$searchKey}%")
                ->orWhere("consignee_state", "LIKE", "%{$searchKey}%")
                ->orWhere("consignee_address", "LIKE", "%{$searchKey}%")
                ->orWhere("barcode_no", "LIKE", "%{$searchKey}%");
        });
    }

    // Date filtering
    if (!empty($fromdate) || !empty($todate)) {
        if (!empty($fromdate) && !empty($todate)) {
            $fromdate = Carbon::createFromFormat("d-m-Y", $fromdate)
                ->startOfDay()
                ->toDateString();
            $todate = Carbon::createFromFormat("d-m-Y", $todate)
                ->startOfDay()
                ->toDateString();
            $query->whereBetween("created_at", [$fromdate, $todate]);
        } elseif (!empty($fromdate)) {
            $fromdate = Carbon::createFromFormat("d-m-Y", $fromdate)->toDateString();
            $query->whereDate("created_at", $fromdate);
        } elseif (!empty($todate)) {
            $todate = Carbon::createFromFormat("d-m-Y", $todate)->toDateString();
            $query->whereDate("created_at", $todate);
        }
    } else {
        $query->whereDate("created_at", Carbon::today());
    }

    // Clone query for totals (without pagination)
    $countQuery = clone $query;
    $totalParcels = $countQuery->count();
    $CodtotalAmount = $countQuery->sum("cod_amount");
    $totalAmount = $countQuery->sum("payment_amount");

    // Apply pagination (50 records per page)
    $datas = $query->paginate(50)->withQueryString();

    return view(
        "franchise.indiaPost-speedPost.index",
        compact(
            "datas",
            "type",
            "totalAmount",
            "totalParcels",
            "CodtotalAmount",
            "franchise"
        )
    );
}

/**
 * Check price in database table first, then calculate if not found
 */
private function getPriceFromDBOrCalculate($origin, $destination, $weight, $fuel_charge = 0, $pickup_charge = 0, $other_service_charge = 0, $register_amount = 0)
{
    $weight = round(floatval($weight), 2);
    
    // Step 1: Check in pincode_distance_prices table
    $existingPrice = DB::table('pincode_distance_prices')
        ->where('origin_pincode', $origin)
        ->where('destination_pincode', $destination)
        ->where('weight', $weight)
        ->first();
    
    if ($existingPrice) {
        // Update hit count and last used
        DB::table('pincode_distance_prices')
            ->where('id', $existingPrice->id)
            ->update([
                'hit_count' => $existingPrice->hit_count + 1,
                'last_used_at' => now()
            ]);
        
        \Log::info("✅ Price found in database table for {$origin}-{$destination}-{$weight}kg");
        
        // Calculate additional charges
        $additionalCharges = $fuel_charge + $pickup_charge + $other_service_charge + $register_amount;
        $subtotal = $existingPrice->price + $additionalCharges;
        $gst = $subtotal * 0.18;
        $total = $subtotal + $gst;
        
        return [
            'status' => 'success',
            'price' => round($existingPrice->price, 2),
            'fuel_charge' => $fuel_charge,
            'pickup_charge' => $pickup_charge,
            'other_service_charge' => $other_service_charge,
            'register_amount' => $register_amount,
            'subtotal' => round($subtotal, 2),
            'gst' => round($gst, 2),
            'total' => round($total, 2),
            'weight_used' => $weight,
            'source' => 'database_table',
            'message' => 'Price retrieved from database table'
        ];
    }
    
    // Step 2: Calculate via API if not found in table
    \Log::info("🔄 Price not found in database, calculating for {$origin}-{$destination}-{$weight}kg");
    
    $result = $this->calculatePriceDirect($origin, $destination, $weight, $fuel_charge, $pickup_charge, $other_service_charge, $register_amount);
    
    // Step 3: Store in database table if calculation successful
    if ($result['status'] === 'success') {
        try {
            DB::table('pincode_distance_prices')->insert([
                'origin_pincode' => $origin,
                'destination_pincode' => $destination,
                'weight' => $weight,
                'price' => $result['price'],
                'gst' => $result['gst'],
                'total' => $result['total'],
                'distance_km' => null, // You can add distance calculation if needed
                'hit_count' => 1,
                'last_used_at' => now(),
                'created_at' => now(),
                'updated_at' => now()
            ]);
            \Log::info("✅ Price stored in database table for {$origin}-{$destination}-{$weight}kg");
        } catch (\Exception $e) {
            \Log::error("Failed to store price in database: " . $e->getMessage());
        }
        
        $result['source'] = 'api_calculation';
    }
    
    return $result;
}


 private function getCachedPrice($origin, $destination, $weight, $fuel_charge = 0, $pickup_charge = 0, $other_service_charge = 0, $register_amount = 0)
{
    $cacheKey = "indiapost_rate_{$origin}_{$destination}_{$weight}_{$fuel_charge}_{$pickup_charge}_{$other_service_charge}_{$register_amount}";
    
    // Pehle cache check
    $cachedResult = Cache::get($cacheKey);
    if ($cachedResult) {
        return $cachedResult;
    }
    
    // Cache mein nahi mila to database/calculation se lein
    $result = $this->getPriceFromDBOrCalculate($origin, $destination, $weight, $fuel_charge, $pickup_charge, $other_service_charge, $register_amount);
    
    // Cache mein store karein (1 week)
    if ($result['status'] === 'success') {
        Cache::put($cacheKey, $result, 604800);
    }
    
    return $result;
}
    
  
   private function calculatePriceDirect($origin, $destination, $weight, $fuel_charge = 0, $pickup_charge = 0, $other_service_charge = 0, $register_amount = 0)
{
    $weight = floatval($weight);
    
    $request = new Request([
        "originPincode" => $origin,
        "destinationPincode" => $destination,
        "packageWeight" => $weight,
        "service_type" => IndiaPostSpeedPostParcel::SERVICE_TYPE_INDIA_POST_SPEED,
    ]);
    
    try {
        \Log::info("Calling RateCalculator with: " . json_encode($request->all()));
        
        $rateCalculator = new RateCalculator();
        $result = $rateCalculator->calculate($request);
        
        \Log::info("RateCalculator response: " . json_encode($result));
        
        if ($result['status'] === 'fail') {
            return $result;
        }
        
        $basePrice = $result['price'] ?? 0;
        $subTotal = $basePrice + $fuel_charge + $pickup_charge + $other_service_charge + $register_amount;
        $gst = $subTotal * 0.18;
        $total = $subTotal + $gst;
        
        return [
            'status' => 'success',
            'price' => round($basePrice, 2),
            'fuel_charge' => $fuel_charge,
            'pickup_charge' => $pickup_charge,
            'other_service_charge' => $other_service_charge,
            'register_amount' => $register_amount,
            'subtotal' => round($subTotal, 2),
            'gst' => round($gst, 2),
            'total' => round($total, 2),
            'weight_used' => $weight,
            'message' => 'Price calculated successfully'
        ];
        
    } catch (\Exception $e) {
        \Log::error("RateCalculator exception: " . $e->getMessage());
        
        // Fallback to mock prices if API fails
        $basePrice = $this->getMockPrice($origin, $destination, $weight);
        
        if ($basePrice === false) {
            return [
                'status' => 'fail',
                'message' => 'Service not available. Please try again later.'
            ];
        }
        
        $subTotal = $basePrice + $fuel_charge + $pickup_charge + $other_service_charge + $register_amount;
        $gst = $subTotal * 0.18;
        $total = $subTotal + $gst;
        
        return [
            'status' => 'success',
            'price' => round($basePrice, 2),
            'fuel_charge' => $fuel_charge,
            'pickup_charge' => $pickup_charge,
            'other_service_charge' => $other_service_charge,
            'register_amount' => $register_amount,
            'subtotal' => round($subTotal, 2),
            'gst' => round($gst, 2),
            'total' => round($total, 2),
            'weight_used' => $weight,
            'message' => 'Price calculated (fallback mode)'
        ];
    }
}

