public function previewByFile(Request $request)
{
    ini_set('memory_limit', '1024M');
    set_time_limit(300);
    
    \Log::info('=== EXCEL PREVIEW STARTED ===');
    
    try {
        // ✅ STEP 0: Check if table exists
        try {
            $tableCheck = DB::select("SHOW TABLES LIKE 'pincode_distance_prices'");
            if (empty($tableCheck)) {
                \Log::error("❌ Table 'pincode_distance_prices' does not exist!");
                return response()->json([
                    'status' => false,
                    'message' => 'Database table pincode_distance_prices does not exist. Please create it first.'
                ], 500);
            }
            \Log::info("✅ Table exists");
        } catch (\Exception $e) {
            \Log::error("❌ Table check failed: " . $e->getMessage());
        }
        
        if (!$request->hasFile('file')) {
            return response()->json(['status' => false, 'message' => 'No file uploaded'], 400);
        }

        $filePath = $request->file('file')->getRealPath();
        
        // Read Excel file
        $reader = IOFactory::createReaderForFile($filePath);
        $reader->setReadDataOnly(true);
        $spreadsheet = $reader->load($filePath);
        $sheet = $spreadsheet->getActiveSheet();
        
        $rows = $sheet->toArray();
        if (empty($rows)) {
            return response()->json(['status' => false, 'message' => 'Empty file'], 400);
        }

        $header = array_shift($rows);
        $totalRows = count($rows);
        
        \Log::info("Total rows: {$totalRows}");

        $uniqueCombinations = [];
        $rowData = [];
        
        foreach ($rows as $rowIndex => $row) {
            $rowAssoc = [];
            foreach ($header as $colIndex => $colName) {
                $rowAssoc[trim($colName)] = $row[$colIndex] ?? '';
            }
            
            if (empty($rowAssoc['Pickup Pincode']) || empty($rowAssoc['Consignee Pincode']) || empty($rowAssoc['Package Weight'])) {
                continue;
            }
            
            $origin = substr(trim($rowAssoc['Pickup Pincode']), 0, 6);
            $destination = substr(trim($rowAssoc['Consignee Pincode']), 0, 6);
            $weight = round(floatval($rowAssoc['Package Weight'] ?? 0), 2);
            
            $cacheKey = "{$origin}_{$destination}_{$weight}";
            
            $rowData[] = [
                'index' => $rowIndex + 2,
                'data' => $rowAssoc,
                'cache_key' => $cacheKey,
                'origin' => $origin,
                'destination' => $destination,
                'weight' => $weight
            ];
            
            if (!isset($uniqueCombinations[$cacheKey])) {
                $uniqueCombinations[$cacheKey] = [
                    'origin' => $origin,
                    'destination' => $destination,
                    'weight' => $weight,
                    'count' => 0
                ];
            }
            $uniqueCombinations[$cacheKey]['count']++;
        }

        \Log::info("Unique combinations: " . count($uniqueCombinations));

        $stats = [
            'from_db' => 0,
            'calculated_and_stored' => 0,
            'failed' => 0,
            'insert_errors' => 0
        ];
        
        $priceCache = [];
        
        foreach ($uniqueCombinations as $cacheKey => $combination) {
            \Log::info("Processing combination: {$cacheKey}");
            
            try {
                // Check in database
                $dbRecord = DB::table('pincode_distance_prices')
                    ->where('origin_pincode', $combination['origin'])
                    ->where('destination_pincode', $combination['destination'])
                    ->where('weight', $combination['weight'])
                    ->first();
                
                if ($dbRecord) {
                    \Log::info("✅ Found in DB: {$cacheKey}");
                    $priceCache[$cacheKey] = [
                        'status' => 'success',
                        'price' => $dbRecord->price,
                        'gst' => $dbRecord->gst,
                        'total' => $dbRecord->total,
                        'source' => 'database'
                    ];
                    
                    // Update hit count
                    DB::table('pincode_distance_prices')
                        ->where('id', $dbRecord->id)
                        ->update([
                            'hit_count' => $dbRecord->hit_count + 1,
                            'last_used_at' => now()
                        ]);
                    
                    $stats['from_db']++;
                    
                } else {
                    \Log::info("🔄 Not in DB, calculating: {$cacheKey}");
                    
                    $priceResult = $this->calculatePriceDirect(
                        $combination['origin'],
                        $combination['destination'],
                        $combination['weight'],
                        0, 0, 0, 0
                    );
                    
                    if ($priceResult['status'] == 'success') {
                        \Log::info("✅ Calculated price: {$priceResult['price']} for {$cacheKey}");
                        
                        // Try to insert in database
                        try {
                            $insertData = [
                                'origin_pincode' => $combination['origin'],
                                'destination_pincode' => $combination['destination'],
                                'weight' => $combination['weight'],
                                'price' => $priceResult['price'],
                                'gst' => $priceResult['gst'],
                                'total' => $priceResult['total'],
                                'distance_km' => null,
                                'hit_count' => 1,
                                'last_used_at' => now(),
                                'created_at' => now(),
                                'updated_at' => now()
                            ];
                            
                            \Log::info("Attempting DB insert:", $insertData);
                            
                            $inserted = DB::table('pincode_distance_prices')->insert($insertData);
                            
                            if ($inserted) {
                                \Log::info("✅ Successfully inserted into DB: {$cacheKey}");
                                $stats['calculated_and_stored']++;
                            } else {
                                \Log::error("❌ DB insert returned false for {$cacheKey}");
                                $stats['insert_errors']++;
                            }
                            
                        } catch (\Exception $e) {
                            \Log::error("❌ DB insert exception for {$cacheKey}: " . $e->getMessage());
                            $stats['insert_errors']++;
                        }
                        
                        $priceCache[$cacheKey] = $priceResult;
                        
                    } else {
                        \Log::error("❌ Calculation failed for {$cacheKey}");
                        $priceCache[$cacheKey] = $priceResult;
                        $stats['failed']++;
                    }
                }
                
            } catch (\Exception $e) {
                \Log::error("❌ Error processing {$cacheKey}: " . $e->getMessage());
                $priceCache[$cacheKey] = [
                    'status' => 'fail',
                    'message' => $e->getMessage()
                ];
                $stats['failed']++;
            }
        }

        // Calculate totals for preview
        $successRows = 0;
        $failedRows = 0;
        $totalAmount = 0;
        $totalGst = 0;
        $totalNetAmount = 0;
        $failedDetails = [];
        
        foreach ($rowData as $item) {
            $cacheKey = $item['cache_key'];
            $row = $item['data'];
            $rowNumber = $item['index'];
            
            if (!isset($priceCache[$cacheKey]) || $priceCache[$cacheKey]['status'] != 'success') {
                $failedRows++;
                $failedDetails[] = [
                    'row' => $rowNumber,
                    'error' => $priceCache[$cacheKey]['message'] ?? 'Price not available',
                    'pincodes' => [
                        'from' => $row['Pickup Pincode'] ?? '',
                        'to' => $row['Consignee Pincode'] ?? ''
                    ]
                ];
                continue;
            }
            
            $priceResult = $priceCache[$cacheKey];
            
            $fuel_charge = floatval($row['Fuel Charge'] ?? 0);
            $pickup_charge = floatval($row['Pickup Charge'] ?? 0);
            $other_service_charge = floatval($row['Other service Charge'] ?? 0);
            $register_amount = floatval($row['Register Fee'] ?? 0);
            
            $basePrice = $priceResult['price'] ?? 0;
            $additionalCharges = $fuel_charge + $pickup_charge + $other_service_charge + $register_amount;
            $subtotal = $basePrice + $additionalCharges;
            $gst = $subtotal * 0.18;
            $paymentAmount = $subtotal + $gst;
            
            $totalAmount += $paymentAmount;
            $totalGst += $gst;
            $totalNetAmount += $subtotal;
            $successRows++;
        }

        \Log::info("Preview completed. Stats: " . json_encode($stats));

        return response()->json([
            'status' => true,
            'message' => 'Preview generated successfully',
            'data' => [
                'total_rows' => $totalRows,
                'success_rows' => $successRows,
                'failed_rows' => $failedRows,
                'stats' => $stats,
                'total_amount' => number_format($totalAmount, 2),
                'gst_amount' => number_format($totalGst, 2),
                'net_amount' => number_format($totalNetAmount, 2),
                'failed_details' => array_slice($failedDetails, 0, 50)
            ]
        ]);
        
    } catch (\Throwable $e) {
        \Log::error('Preview error: ' . $e->getMessage());
        \Log::error($e->getTraceAsString());
        
        return response()->json([
            'status' => false,
            'message' => 'Preview failed: ' . $e->getMessage()
        ], 500);
    }
}



