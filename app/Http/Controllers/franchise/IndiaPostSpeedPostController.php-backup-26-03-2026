private function calculatePriceWithDistanceAndWeight($origin, $distance, $weightInGrams)
{
    try {
        // Determine distance category
        if ($distance <= 63) {
            $distanceCategory = 'Local';
        } elseif ($distance <= 200) {
            $distanceCategory = 'upto_200_kms';
        } elseif ($distance <= 500) {
            $distanceCategory = 'rate_201_to_500_kms';
        } elseif ($distance <= 1000) {
            $distanceCategory = 'rate_501_to_1000_kms';
        } elseif ($distance <= 2000) {
            $distanceCategory = 'rate_1001_to_2000_kms';
        } else {
            $distanceCategory = 'above_2000_kms';
        }
        
        \Log::info("Price calculation: Weight={$weightInGrams}g, Distance={$distance}km, Category={$distanceCategory}");
        
        // Get price from PostalRates based on weight
        $rate = null;
        $rateUsed = '';
        
        if ($weightInGrams <= 50) {
            $rate = PostalRates::where('weight', 'Up to 50 gm')->first();
            $rateUsed = 'Up to 50 gm';
        } elseif ($weightInGrams <= 250) {
            $rate = PostalRates::where('weight', '51 to 250 gm')->first();
            $rateUsed = '51 to 250 gm';
        } elseif ($weightInGrams <= 500) {
            $rate = PostalRates::where('weight', '251 to 500 gm')->first();
            $rateUsed = '251 to 500 gm';
        } else {
            // For weight > 500g
            $baseRate = PostalRates::where('weight', '251 to 500 gm')->first();
            $additionalRate = PostalRates::where('weight', 'Additional 500 gm or part thereof')->first();
            
            if (!$baseRate || !$additionalRate) {
                return [
                    'status' => 'fail',
                    'message' => 'Postal rates not found for weight > 500g'
                ];
            }
            
            $basePrice = $baseRate->$distanceCategory ?? 0;
            $additionalWeight = $weightInGrams - 500;
            $additionalIncrements = ceil($additionalWeight / 500);
            $additionalPrice = $additionalIncrements * ($additionalRate->$distanceCategory ?? 0);
            
            $price = $basePrice + $additionalPrice;
            $gst = $price * 0.18;
            $total = $price + $gst;
            
            return [
                'status' => 'success',
                'price' => round($price, 2),
                'gst' => round($gst, 2),
                'total' => round($total, 2),
                'rate_used' => '251 to 500 gm + Additional',
                'base_price' => $basePrice,
                'additional_increments' => $additionalIncrements,
                'distance_category' => $distanceCategory
            ];
        }
        
        if (!$rate) {
            return [
                'status' => 'fail',
                'message' => "Postal rate not found for weight {$weightInGrams}g"
            ];
        }
        
        $price = $rate->$distanceCategory ?? 0;
        $gst = $price * 0.18;
        $total = $price + $gst;
        
        return [
            'status' => 'success',
            'price' => round($price, 2),
            'gst' => round($gst, 2),
            'total' => round($total, 2),
            'rate_used' => $rateUsed,
            'distance_category' => $distanceCategory
        ];
        
    } catch (\Exception $e) {
        \Log::error("Price calculation error: " . $e->getMessage());
        return [
            'status' => 'fail',
            'message' => $e->getMessage()
        ];
    }
}


































public function storeByFile(Request $request, RateCalculator $rateCalculater) {
    ini_set('memory_limit', '2048M');
    set_time_limit(3600);
    
    if (!$request->hasFile("file")) {
        return response()->json(['status' => 'error', 'message' => 'No file uploaded.'], 400);
    }

    $franchiseId = Franchise::getFranchiseId();
    $franchise = Franchise::findOrFail($franchiseId);
    $barcodeOption = $request->barcode_option; 
    
 
    $specialFranchises = [245, 250,249];
    $isSpecialFranchise = in_array($franchiseId, $specialFranchises);
    
    if ($isSpecialFranchise) {
        \Log::info("🔴 SPECIAL FRANCHISE DETECTED: ID {$franchiseId} - Using special pincode validation");
    } else {
        \Log::info("🟡 NORMAL FRANCHISE: ID {$franchiseId} - Using normal processing");
    }
    
    $successCount = 0;
    $failCount = 0;
    $failedRowsData = [];
    $successRows = [];
    
    $totalAmount = 0;
    $gstAmount = 0;
    $netAmount = 0;

    try {
        $file = $request->file("file");
        $fileName = uniqid() . "_" . $file->getClientOriginalName();
      
        if ($file->getSize() > 20 * 1024 * 1024) {
            return response()->json([
                'status' => 'error', 
                'message' => 'File size too large. Maximum 20MB allowed.'
            ], 400);
        }

        $filePath = $file->getRealPath();
        
        \Log::info("Starting Excel processing for file: {$fileName}");
        \Log::info("File size: " . round($file->getSize() / 1024 / 1024, 2) . " MB");
        \Log::info("Barcode option selected: {$barcodeOption}");
        \Log::info("Franchise ID: {$franchiseId}, Is Special: " . ($isSpecialFranchise ? 'Yes' : 'No'));
        
        $reader = IOFactory::createReaderForFile($filePath);
        $reader->setReadDataOnly(true);
        
        $spreadsheet = $reader->load($filePath);
        $sheet = $spreadsheet->getActiveSheet();
        $totalRowCount = $sheet->getHighestRow() - 1;
        
        \Log::info("Total rows in Excel (excluding header): {$totalRowCount}");
   
        if ($totalRowCount > 10000) {
            return response()->json([
                'status' => 'warning',
                'message' => 'Large file detected (' . number_format($totalRowCount) . ' rows). Processing may take time.',
                'continue_processing' => true,
                'row_count' => $totalRowCount
            ], 200);
        }
      
        $data = [];
        $header = null;
      
        foreach ($sheet->getRowIterator() as $rowIndex => $row) {
            $rowData = [];
            $hasData = false;
            
            foreach ($row->getCellIterator() as $cell) {
                $cellValue = $cell->getValue();
                $rowData[] = $cellValue;
                if (!is_null($cellValue) && trim((string)$cellValue) !== "") { 
                    $hasData = true; 
                }
            }
            
            if ($hasData) {
                if (is_null($header)) { 
                    $header = $rowData; 
                    \Log::info("Header found with " . count($header) . " columns");
                    \Log::info("Header columns: " . json_encode($header));
                } else { 
                    $data[] = array_combine($header, array_pad($rowData, count($header), null));
                }
            }
            
            if ($rowIndex % 1000 === 0) {
                \Log::info("Read {$rowIndex} rows...");
                gc_collect_cycles();
            }
        }
        
        \Log::info("Total data rows collected: " . count($data));
      
        $validationErrors = $this->validateBarcodeRules($data, $barcodeOption, $franchiseId);
        
        if (!empty($validationErrors)) {
            return response()->json([
                'status' => 'validation_error',
                'message' => 'Barcode validation failed',
                'validation_errors' => $validationErrors,
                'preview_blocked' => true
            ], 400);
        }
        
        unset($spreadsheet, $sheet, $reader);
        
        // Get first origin for logging
        $firstOrigin = null;
        $sampleSize = min(50, count($data));
        
        for ($i = 0; $i < $sampleSize; $i++) {
            $currentOrigin = $data[$i]["Pickup Pincode"] ?? '';
            if ($firstOrigin === null) {
                $firstOrigin = $currentOrigin;
            }
        }
        
        // 🔴 PROCESSING MODE BASED ON FRANCHISE
        if ($isSpecialFranchise) {
            // Special franchises ke liye batch size 500
            \Log::info("Using special franchise mode with batch size 500");
            $batchSize = 500;
            $processingMode = 'special_franchise';
        } else {
            // Normal franchises ke liye
            \Log::info("Using normal mode with batch size 200");
            $batchSize = 200;
            $processingMode = 'normal';
        }
        
        $bulkBatchId = $this->generateBatchNumber($franchiseId);
        $batchSequence = 1;
        
        \Log::info("Batch ID: {$bulkBatchId}, Mode: {$processingMode}, Batch Size: {$batchSize}");
        \Log::info("Special Franchise: " . ($isSpecialFranchise ? 'Yes' : 'No'));
        
        $totalBatches = ceil(count($data) / $batchSize);
        
        for ($batchIndex = 0; $batchIndex < $totalBatches; $batchIndex++) {
            $start = $batchIndex * $batchSize;
            $batch = array_slice($data, $start, $batchSize);
            
            \Log::info("Processing batch " . ($batchIndex + 1) . "/{$totalBatches}");
            
            // 🔴 PASS isSpecialFranchise FLAG
            $this->processBatch(
                $batch,
                $franchise,
                $barcodeOption,
                $successCount,
                $failCount,
                $successRows,
                $failedRowsData,
                $totalAmount,
                $gstAmount,
                $netAmount,
                $bulkBatchId,
                $batchSequence,
                $processingMode,
                $firstOrigin,
                $isSpecialFranchise  // 🔴 SPECIAL FRANCHISE FLAG
            );
            
            $batchSequence++;
            gc_collect_cycles();
            
            $processedRows = ($batchIndex + 1) * $batchSize;
            $progress = min(100, round(($processedRows / count($data)) * 100, 2));
            \Log::info("Progress: {$progress}%");
            
            if ($batchIndex < $totalBatches - 1) {
                usleep(50000);
            }
        }
        
        \Log::info("Processing complete. Success: {$successCount}, Failed: {$failCount}");
        
        // Debugging logs
        \Log::info("========== FINAL CHECK ==========");
        \Log::info("Total Success: {$successCount}");
        \Log::info("Total Failed: {$failCount}");
        \Log::info("Failed rows data count: " . count($failedRowsData));
        
        if ($failCount > 0) {
            \Log::info("First 3 failed rows: " . json_encode(array_slice($failedRowsData, 0, 3)));
        }
        
        if ($successCount == 0 && $failCount > 0) {
            return response()->json([
                'status' => 'error',
                'message' => 'All rows failed to process',
                'failed_rows' => array_slice($failedRowsData, 0, 50)
            ], 400);
        }

        $sessionKey = 'excel_preview_' . $franchiseId . '_' . time();
        
        $sessionData = [
            'success_rows' => $successRows,
            'failed_rows' => $failedRowsData,
            'barcode_option' => $barcodeOption,
            'franchise_id' => $franchiseId,
            'bulk_batch_id' => $bulkBatchId,
            'processing_mode' => $processingMode,
            'origin' => $firstOrigin,
            'is_special_franchise' => $isSpecialFranchise,
            'amounts' => [
                'total_amount' => round($totalAmount, 2),
                'gst_amount' => round($gstAmount, 2),
                'net_amount' => round($netAmount, 2)
            ],
            'summary' => [
                'total_rows' => $successCount + $failCount,
                'success' => $successCount,
                'failed' => $failCount
            ]
        ];
        
        \Log::info("Session data failed rows count: " . count($sessionData['failed_rows']));
        
        session([$sessionKey => $sessionData]);
        
        $response = [
            'status' => 'success',
            'message' => 'File processed successfully',
            'data' => [
                'success_rows_count' => $successCount,
                'failed_rows_count' => $failCount,
                'failed_rows' => $failedRowsData,
                'session_key' => $sessionKey,
                'bulk_batch_id' => $bulkBatchId,
                'processing_mode' => $processingMode,
                'origin' => $firstOrigin,
                'is_special_franchise' => $isSpecialFranchise,
                'summary' => [
                    'total_rows' => $successCount + $failCount,
                    'success' => $successCount,
                    'failed' => $failCount,
                    'total_amount' => round($totalAmount, 2),
                    'gst_amount' => round($gstAmount, 2),
                    'net_amount' => round($netAmount, 2)
                ]
            ]
        ];
        
        if ($successCount > 0) {
            $response['data']['success_rows_sample'] = array_slice($successRows, 0, min(5, $successCount));
        }
        
        return response()->json($response);

    } catch (\Exception $e) {
        \Log::error('Excel upload error: ' . $e->getMessage());
        \Log::error($e->getTraceAsString());
        
        return response()->json([
            'status' => 'error', 
            'message' => 'File processing failed: ' . $e->getMessage()
        ], 500);
    }
}




private function validateBarcodeRules($data, $barcodeOption, $franchiseId)
{
    $errors = [];
    $barcodeColumn = null;
    
    // First, find the barcode column
    if (!empty($data)) {
        foreach ($data[0] as $key => $value) {
            if (strtolower(trim($key)) === 'barcode') {
                $barcodeColumn = $key;
                break;
            }
        }
    }
    
    \Log::info("Barcode column found: " . ($barcodeColumn ?: 'Not found'));
    
    // Check 1: For custom barcode option, ensure barcode column exists
    if ($barcodeOption === 'barcode_custom' && !$barcodeColumn) {
        $errors[] = [
            'row' => 'ALL',
            'message' => 'Barcode column is missing in the Excel file',
            'column' => 'Barcode',
            'value' => '',
            'error_type' => 'missing_column'
        ];
        return $errors;
    }
    
    // Step 1: Collect all barcode values for various checks
    $fileBarcodeValues = [];
    $rowsWithMissingBarcode = [];
    $rowsWithBarcode = [];
    
    foreach ($data as $rowIndex => $row) {
        $rowNumber = $rowIndex + 2;
        $barcodeValue = isset($row[$barcodeColumn]) ? trim((string)$row[$barcodeColumn]) : '';
        
        // Track barcodes for duplicate check
        if (!empty($barcodeValue)) {
            if (isset($fileBarcodeValues[$barcodeValue])) {
                $fileBarcodeValues[$barcodeValue]['count']++;
                $fileBarcodeValues[$barcodeValue]['rows'][] = $rowNumber;
            } else {
                $fileBarcodeValues[$barcodeValue] = [
                    'count' => 1,
                    'rows' => [$rowNumber]
                ];
            }
            $rowsWithBarcode[$rowNumber] = $barcodeValue;
        } else {
            // Track rows with missing barcode
            $rowsWithMissingBarcode[] = $rowNumber;
        }
    }
    
    // Step 2: For custom barcode option, check for missing barcodes
    if ($barcodeOption === 'barcode_custom') {
        foreach ($rowsWithMissingBarcode as $rowNumber) {
            $errors[] = [
                'row' => $rowNumber,
                'message' => 'Barcode is required for custom barcode option',
                'column' => $barcodeColumn,
                'value' => '',
                'error_type' => 'missing_barcode'
            ];
        }
        
        // If there are missing barcodes, we can still check for duplicates
        // in rows that do have barcodes
    }
    
    // Step 3: Check for duplicates within the file
    foreach ($fileBarcodeValues as $barcodeValue => $info) {
        if ($info['count'] > 1) {
            foreach ($info['rows'] as $rowNumber) {
                $errors[] = [
                    'row' => $rowNumber,
                    'message' => "Barcode '{$barcodeValue}' is duplicate within the Excel file",
                    'column' => $barcodeColumn,
                    'value' => $barcodeValue,
                    'error_type' => 'duplicate_in_file'
                ];
            }
        }
    }
    
    // Step 4: Check database for existing barcodes (ONLY for custom barcode option)
    // IMPORTANT: Only check if we have barcodes to check
    if ($barcodeOption === 'barcode_custom' && !empty($fileBarcodeValues)) {
        $barcodeValuesToCheck = array_keys($fileBarcodeValues);
        
        // Batch query to check all barcodes at once
        $existingBarcodes = IndiaPostSpeedPostParcel::whereIn("barcode_no", $barcodeValuesToCheck)
            ->where("franchise_id", $franchiseId)
            ->whereDate("created_at", Carbon::today())
            ->pluck('barcode_no')
            ->toArray();
        
        \Log::info("Existing barcodes in database: " . json_encode($existingBarcodes));
        
        if (!empty($existingBarcodes)) {
            // Create a lookup array for quick checking
            $existingBarcodeLookup = array_flip($existingBarcodes);
            
            // Check each barcode value
            foreach ($fileBarcodeValues as $barcodeValue => $info) {
                if (isset($existingBarcodeLookup[$barcodeValue])) {
                    foreach ($info['rows'] as $rowNumber) {
                        $errors[] = [
                            'row' => $rowNumber,
                            'message' => "Barcode '{$barcodeValue}' already exists in the database (used today)",
                            'column' => $barcodeColumn,
                            'value' => $barcodeValue,
                            'error_type' => 'duplicate_in_database'
                        ];
                    }
                }
            }
        }
    }
    
    // Step 5: For auto generate option, check for unexpected barcodes
    if ($barcodeOption === 'barcode_auto') {
        foreach ($rowsWithBarcode as $rowNumber => $barcodeValue) {
            $errors[] = [
                'row' => $rowNumber,
                'message' => 'Barcode should be empty for auto generate option',
                'column' => $barcodeColumn,
                'value' => $barcodeValue,
                'error_type' => 'unexpected_barcode'
            ];
        }
    }
    
    // Step 6: Sort errors by row number for better display
    usort($errors, function($a, $b) {
        // Handle 'ALL' row first
        if ($a['row'] === 'ALL') return -1;
        if ($b['row'] === 'ALL') return 1;
        
        // Then sort by numeric row
        return $a['row'] - $b['row'];
    });
    
    return $errors;
}

public function confirmAndStoreExcel(Request $request, RateCalculator $rateCalculater)
{
    ini_set('memory_limit', '2048M');
    set_time_limit(3600);
    \Log::info('=== CONFIRM EXCEL CALLED ===');
    
    $sessionKey = $request->input('session_key');
    
