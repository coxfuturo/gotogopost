/**
 * Determine booking type from customer type
 */
private function determineBookingTypeFromCustomer($customer)
{
    if (!$customer) {
        return 'franchise'; // Default fallback
    }
    
    \Log::info("Customer type for booking determination: " . $customer->type);
    
    switch ($customer->type) {
        case 'manager':
            return 'manager';
        case 'pickup':
            return 'pickup';
        case 'franchise':
        default:
            return 'franchise';
    }
