private function generateBatchNumber($franchiseId)
{

    $prefix = "BATCH";
    
    
    $lastBatch = IndiaPostSpeedPostParcel::where('franchise_id', $franchiseId)
        ->where('bulk_batch_id', 'like', $prefix . '%')
        ->orderBy('bulk_batch_id', 'desc')
        ->first();
    
    if ($lastBatch) {
     
        $lastNumber = intval(substr($lastBatch->bulk_batch_id, 5));
        $newNumber = $lastNumber + 1;
        $newSequence = str_pad($newNumber, 6, '0', STR_PAD_LEFT);
    } else {
      
        $newSequence = '000001';
    }
    
    $batchId = $prefix . $newSequence; 
    
    \Log::info("========== BULK BATCH ID GENERATED ==========");
    \Log::info("Franchise ID: {$franchiseId}");
    \Log::info("Batch ID: {$batchId}");
    
    return $batchId;
}

