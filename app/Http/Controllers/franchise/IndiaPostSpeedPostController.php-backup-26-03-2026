/**
 * Normal batch processing for mixed origins
 */
private function processNormalBatch(
    $batchData,
    $franchise,
    $barcodeOption,
    &$successCount,
    &$failCount,
    &$successRows,
    &$failedRowsData,
    &$totalAmount,
    &$gstAmount,
    &$netAmount,
    $bulkBatchId,
    $batchSequence,
    $getSrNo
) {
    \Log::info("========== NORMAL BATCH PROCESSING STARTED ==========");
    
    // Collect unique combinations
    $uniqueCombinations = [];
    $rowSrNoMap = [];
    
    foreach ($batchData as $index => $element) {
        $srNo = $getSrNo($element);
        $rowSrNoMap[$index] = $srNo;
        
        $origin = trim($element["Pickup Pincode"] ?? '');
        $destination = trim($element["Consignee Pincode"] ?? '');
        $weight = floatval($element["Package Weight"] ?? 0);
        
        if (empty($origin) || empty($destination) || $weight <= 0) {
            \Log::warning("Row {$index} skipped - missing required fields");
            continue;
        }
        
        $cacheKey = "{$origin}_{$destination}_{$weight}";
        
        if (!isset($uniqueCombinations[$cacheKey])) {
            $uniqueCombinations[$cacheKey] = [
                'origin' => $origin,
                'destination' => $destination,
                'weight' => $weight,
                'rows' => []
            ];
        }
        $uniqueCombinations[$cacheKey]['rows'][] = $index;
    }
    
    \Log::info("Unique combinations found: " . count($uniqueCombinations));
    
    // Calculate prices for unique combinations
    $priceCache = [];
    $cacheHits = 0;
    $cacheMisses = 0;
    
    foreach ($uniqueCombinations as $cacheKey => $combination) {
        try {
            $cachedPrice = Cache::get("excel_price_{$cacheKey}");
            if ($cachedPrice) {
                $priceCache[$cacheKey] = $cachedPrice;
                $cacheHits++;
                \Log::info("✅ Cache HIT for {$cacheKey}");
                continue;
            }
            
            $priceResult = $this->getCachedPrice(
                $combination['origin'], 
                $combination['destination'], 
                $combination['weight'],
                0, 0, 0, 0  
            );
            
            if ($priceResult["status"] == "success") {
                Cache::put("excel_price_{$cacheKey}", $priceResult, 604800);
                $priceCache[$cacheKey] = $priceResult;
                $cacheMisses++;
                \Log::info("✅ Calculated and cached price for {$cacheKey}");
            } else {
                throw new \Exception($priceResult["message"]);
            }
            
        } catch (\Exception $e) {
            $priceCache[$cacheKey] = ['status' => 'fail', 'message' => $e->getMessage()];
            \Log::error("❌ Price calculation failed for {$cacheKey}: " . $e->getMessage());
        }
    }
    
    \Log::info("Cache stats - Hits: {$cacheHits}, Misses: {$cacheMisses}");
    
    // Process each row
    $batchSuccessCount = 0;
    $batchFailCount = 0;
    
    foreach ($batchData as $index => $element) {
        try {
            $srNo = $rowSrNoMap[$index] ?? '';
            
            $origin = trim($element["Pickup Pincode"]);
            $destination = trim($element["Consignee Pincode"]);
            $weight = floatval($element["Package Weight"]);
            
            $cacheKey = "{$origin}_{$destination}_{$weight}";
            
            if (!isset($priceCache[$cacheKey]) || $priceCache[$cacheKey]['status'] != 'success') {
                throw new \Exception("Price not available for route: {$origin} to {$destination}");
            }
            
            $basePriceResult = $priceCache[$cacheKey];
            $basePrice = (float)($basePriceResult["price"] ?? 0);
            
            $fuel_charge = floatval($element["Fuel Charge"] ?? 0);
            $pickup_charge = floatval($element["Pickup Charge"] ?? 0);
            $other_service_charge = floatval($element["Other service Charge"] ?? 0);
            $register_amount = floatval($element["Register Fee"] ?? 0);
            
            $additionalCharges = $fuel_charge + $pickup_charge + $other_service_charge + $register_amount;
            $subtotal = $basePrice + $additionalCharges;
            $gst = $subtotal * 0.18;
            $payment_amount = $subtotal + $gst;
            
            $successRow = [
                'data' => $element,
                'calculated_price' => round($payment_amount, 2),
                'calculated_gst' => round($gst, 2),
                'calculated_net' => round($subtotal, 2),
                'calculated_weight' => $weight,
                'barcode_option' => $barcodeOption,
                'excel_sr_no' => $srNo,
                'excel_row_index' => $index,
                'bulk_batch_id' => $bulkBatchId,
                'batch_sequence' => $batchSequence,
                'calculation_type' => 'normal'
            ];
            
            $successRows[] = $successRow;
            $batchSuccessCount++;
            
            $totalAmount += $payment_amount;
            $gstAmount += $gst;
            $netAmount += $subtotal;
            
        } catch (\Exception $e) {
            $batchFailCount++;
            $element["Error Reason"] = $e->getMessage();
            $element["sr_no"] = $rowSrNoMap[$index] ?? '';
            $element["row_index"] = $index;
            $element["bulk_batch_id"] = $bulkBatchId;
            $element["batch_sequence"] = $batchSequence;
            
            $failedRowsData[] = $element;
            \Log::error("❌ Row {$index} failed: " . $e->getMessage());
        }
    }
    
    $successCount += $batchSuccessCount;
    $failCount += $batchFailCount;
    
    \Log::info("Normal batch completed - Success: {$batchSuccessCount}, Failed: {$batchFailCount}");
}

private function processSpecialFranchiseBatch(
    $batchData,
    $franchise,
    $barcodeOption,
    &$successCount,
    &$failCount,
    &$successRows,
    &$failedRowsData,
    &$totalAmount,
    &$gstAmount,
    &$netAmount,
    $bulkBatchId,
    $batchSequence,
    $getSrNo
) {
    $startTime = microtime(true);
    \Log::info("========== SPECIAL FRANCHISE BATCH PROCESSING ==========");
    
    // STEP 1: सारे pincodes clean करके इकट्ठा करो
    $allPickups = [];
    $allConsignees = [];
    $rowData = [];
    
    foreach ($batchData as $index => $element) {
        $srNo = $getSrNo($element);
        $pickupPincode = preg_replace('/\s+/', '', trim($element["Pickup Pincode"] ?? ''));
        $consigneePincode = preg_replace('/\s+/', '', trim($element["Consignee Pincode"] ?? ''));
        $weight = floatval($element["Package Weight"] ?? 0);
        
        if (empty($pickupPincode)) {
            $failCount++;
            $element["Error Reason"] = "Pickup Pincode is missing";
            $failedRowsData[] = $element;
            continue;
        }
        
        if ($weight <= 0) {
            $failCount++;
            $element["Error Reason"] = "Invalid package weight";
            $failedRowsData[] = $element;
            continue;
        }
        
        $allPickups[$pickupPincode] = $pickupPincode;
        if (!empty($consigneePincode)) {
            $allConsignees[$consigneePincode] = $consigneePincode;
        }
        
        $rowData[] = [
            'index' => $index,
            'sr_no' => $srNo,
            'pickup' => $pickupPincode,
            'consignee' => $consigneePincode,
            'weight' => $weight,
            'element' => $element
        ];
    }
    
    \Log::info("Valid rows to process: " . count($rowData));
    \Log::info("Unique pickup pincodes: " . json_encode(array_keys($allPickups)));
    \Log::info("Unique consignee pincodes: " . json_encode(array_keys($allConsignees)));
    
    // STEP 2: 🔴 SINGLE QUERY - सिर्फ pincode table check करो
    $allPincodes = array_unique(array_merge($allPickups, $allConsignees));
    $pincodeMasterLookup = [];  // यह बताएगा कि कौन-से pincodes master table में हैं
    
    if (!empty($allPincodes)) {
        $pincodeList = "'" . implode("','", $allPincodes) . "'";
        
        // 🔴 सिर्फ pincode column check करो
        $masterResults = DB::select("
            SELECT pincode 
            FROM pincode_master 
            WHERE pincode IN ($pincodeList)
        ");
        
        foreach ($masterResults as $item) {
            $pincodeMasterLookup[$item->pincode] = true;
        }
        
        \Log::info("Pincodes found in master table: " . json_encode(array_keys($pincodeMasterLookup)));
    }
    
    // STEP 3: PINCODE TABLE CHECK (साधारण pincodes table)
    $validPincodes = [];
    if (!empty($allPincodes)) {
        $pincodeList = "'" . implode("','", $allPincodes) . "'";
        
        $pincodeResults = DB::select("
            SELECT pincode 
            FROM pincodes 
            WHERE pincode IN ($pincodeList)
        ");
        
        foreach ($pincodeResults as $item) {
            $validPincodes[$item->pincode] = true;
        }
        
        // Check कौन-से pincodes missing हैं
        $missingPincodes = array_diff($allPincodes, array_keys($validPincodes));
        \Log::info("Valid pincodes in pincodes table: " . json_encode(array_keys($validPincodes)));
        if (!empty($missingPincodes)) {
            \Log::warning("Pincodes not found in any table: " . json_encode($missingPincodes));
        }
    }
    
    // STEP 4: Postal rates cache
    static $postalRates = null;
    if ($postalRates === null) {
        $rateResults = DB::select("
            SELECT weight, Local, upto_200_kms, rate_201_to_500_kms,
                   rate_501_to_1000_kms, rate_1001_to_2000_kms, above_2000_kms
            FROM postal_rates 
            WHERE weight IN ('Up to 50 gm', '51 to 250 gm', '251 to 500 gm', 'Additional 500 gm or part thereof')
        ");
        
        $postalRates = [];
        foreach ($rateResults as $rate) {
            $postalRates[$rate->weight] = $rate;
        }
    }
    
    // STEP 5: Process each row
    $batchSuccessCount = 0;
    $batchFailCount = 0;
    $priceCache = [];
    $distanceCounts = ['50' => 0, '150' => 0, 'fail_pickup' => 0, 'fail_consignee' => 0];
    
    foreach ($rowData as $item) {
        try {
            $pickup = $item['pickup'];
            $consignee = $item['consignee'];
            $weight = $item['weight'];
            $element = $item['element'];
            $srNo = $item['sr_no'];
            $index = $item['index'];
            
            \Log::info("========== Processing Row {$srNo} ==========");
            \Log::info("Pickup: {$pickup}, Consignee: {$consignee}");
            
            // 🔴 STEP A: पहले check करो कि pickup pincode pincodes table में है या नहीं
            if (!isset($validPincodes[$pickup])) {
                $distanceCounts['fail_pickup']++;
                throw new \Exception("Pickup pincode {$pickup} not found in pincodes table");
            }
            
            // 🔴 STEP B: अब consignee pincode check करो
            $consigneeValid = !empty($consignee) && isset($validPincodes[$consignee]);
            
            if (!$consigneeValid) {
                // Consignee pincode नहीं मिला - FAIL
                $distanceCounts['fail_consignee']++;
                throw new \Exception("Consignee pincode {$consignee} not found in pincodes table");
            }
            
            // 🔴 STEP C: अब देखो कि दोनों pincodes master table में हैं या नहीं
            $pickupInMaster = isset($pincodeMasterLookup[$pickup]);
            $consigneeInMaster = isset($pincodeMasterLookup[$consignee]);
            
            if ($pickupInMaster && $consigneeInMaster) {
                // दोनों master table में हैं → 50km
                $distance = 50;
                $source = 'master_both';
                $distanceCounts['50']++;
                \Log::info("✅ Row {$srNo}: BOTH pincodes in master table - using 50km");
            } else {
                // कोई एक या दोनों master में नहीं → 150km
                $distance = 150;
                $source = 'master_not_both';
                $distanceCounts['150']++;
                \Log::info("🟡 Row {$srNo}: Not both in master table - using 150km");
                \Log::info("   Pickup in master: " . ($pickupInMaster ? 'Yes' : 'No') . 
                          ", Consignee in master: " . ($consigneeInMaster ? 'Yes' : 'No'));
            }
            
            // STEP D: Price calculate करो
            $priceKey = $weight . '_' . $distance;
            if (!isset($priceCache[$priceKey])) {
                $priceResult = $this->fastPriceCalcForSpecial($weight, $distance, $postalRates);
                $priceCache[$priceKey] = $priceResult;
            } else {
                $priceResult = $priceCache[$priceKey];
            }
            
            // STEP E: Additional charges
            $fuel_charge = floatval($element["Fuel Charge"] ?? 0);
            $pickup_charge = floatval($element["Pickup Charge"] ?? 0);
            $other_service_charge = floatval($element["Other service Charge"] ?? 0);
            $register_amount = floatval($element["Register Fee"] ?? 0);
            
            $additionalCharges = $fuel_charge + $pickup_charge + $other_service_charge + $register_amount;
            $subtotal = $priceResult['price'] + $additionalCharges;
            $gst = $subtotal * 0.18;
            $payment_amount = $subtotal + $gst;
            
            \Log::info("Row {$srNo} final: Distance={$distance}km, Base Price={$priceResult['price']}, Total={$payment_amount}");
            
            // STEP F: Success row store करो
            $successRows[] = [
                'data' => $element,
                'calculated_price' => round($payment_amount, 2),
                'calculated_gst' => round($gst, 2),
                'calculated_net' => round($subtotal, 2),
                'base_price' => round($priceResult['price'], 2),
                'base_gst' => round($priceResult['gst'] ?? 0, 2),
                'base_total' => round($priceResult['total'] ?? 0, 2),
                'calculated_weight' => $weight,
                'barcode_option' => $barcodeOption,
                'excel_sr_no' => $srNo,
                'excel_row_index' => $index,
                'bulk_batch_id' => $bulkBatchId,
                'batch_sequence' => $batchSequence,
                'distance_used' => $distance,
                'distance_source' => $source,
                'pickup_in_master' => $pickupInMaster,
                'consignee_in_master' => $consigneeInMaster,
                'rate_used' => $priceResult['rate_used'] ?? 'Unknown',
                'pickup_pincode' => $pickup,
                'consignee_pincode' => $consignee,
            ];
            
            $batchSuccessCount++;
            $totalAmount += $payment_amount;
            $gstAmount += $gst;
            $netAmount += $subtotal;
            
        } catch (\Exception $e) {
            $batchFailCount++;
            $element["Error Reason"] = $e->getMessage();
            $element["sr_no"] = $srNo;
            $element["row_index"] = $index + 2;
            $element["bulk_batch_id"] = $bulkBatchId;
            $element["batch_sequence"] = $batchSequence;
            $failedRowsData[] = $element;
            \Log::error("❌ Row {$srNo} failed: " . $e->getMessage());
        }
    }
    
    $successCount += $batchSuccessCount;
