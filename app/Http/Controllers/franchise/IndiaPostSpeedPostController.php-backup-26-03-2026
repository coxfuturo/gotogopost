                    "package_width" => floatval($element["Package Width"] ?? 0),
                    "package_height" => floatval($element["Package Height"] ?? 0),
                    "fuel_charge" => $fuel_charge,
                    "pickup_charge" => $pickup_charge,
                    "other_service_charge" => $other_service_charge,
                    "register_amount" => $register_amount,
                    "payment_amount" => round($payment_amount, 2),
                    "totalOtherAmount" => round($payment_amount, 2),
                    "payment_method" => "prepaid",
                    "cod_amount" => 0,
                    "barcode_no" => $code,
                    "barcode_image_src" => $barcode_img,
                    "insert_type" => IndiaPostSpeedPostParcel::INSERT_TYPE_BULK,
                ];
                
    
               
                
                $parcel = IndiaPostSpeedPostParcel::create($parcelData);
                
                \Log::info("✅ Parcel created - ID: {$parcel->id}, Barcode: {$code}, Amount: {$payment_amount}, Distance: {$distance}km");
                
                // Create track order
                IndiaPostSpeedPostTrackOrder::create([
                    "parcel_id" => $parcel->id,
                    "barcode_no" => $code,
                    "source_franchise_id" => $franchiseId,
                    "order_placed_datetime" => now(),
                    "source_franchise_location" => $franchise->address ?? '',
                ]);
                
                // Deduct balance
                if ($indiapost_balance >= $payment_amount) {
                    $franchise->decrement("indiapost_balance", $payment_amount);
                } else {
                    $franchise->decrement("india_credit_amount", $payment_amount);
                }
                
                // Calculate commission
                $commission = $rateCalculater->calculateCommissionForIndiaPost(
                    $weight,
                    $payment_amount,
                    IndiaPostSpeedPostParcel::SERVICE_TYPE_INDIA_POST_SPEED
                );
                
                FranchiseCommissionDetail::create([
                    "franchise_id" => $franchiseId,
                    "service_type" => IndiaPostSpeedPostParcel::SERVICE_TYPE_INDIA_POST_SPEED,
                    "amount" => $payment_amount / 1.18,
                    "commission" => number_format($commission, 2, ".", ""),
                    "payment_method" => "prepaid",
                ]);
                
                // Save barcode
                if ($barcodeOption === "barcode_auto" && $franchiseSeriesDetails) {
                    FranchiseBarcodes::create([
                        'barcodes' => $code,
                        'franchise_barcodeseries_id' => $franchiseSeriesDetails->id
                    ]);
                }
                
                $createdParcelIds[] = $parcel->id;
                $successCount++;
                $totalPaymentAmount += $payment_amount;
                
            } catch (\Exception $e) {
                $failCount++;
                $element["Error Reason"] = $e->getMessage();
                $failedRows[] = $element;
                \Log::error("❌ Row failed: " . $e->getMessage());
            }
        }
        
        // Update barcode series
        if ($barcodeOption === "barcode_auto" && $franchiseSeriesDetails && $startBarcode > 0) {
            $currentLastIssued = (int)($franchiseSeriesDetails->{$last_code_issued_column} ?? 0);
            
            \Log::info("Updating barcode series - Current: {$currentLastIssued}, New: {$startBarcode}");
            
            if ($startBarcode > $currentLastIssued) {
                $franchiseSeriesDetails->{$last_code_issued_column} = $startBarcode;
                $franchiseSeriesDetails->save();
                \Log::info("✅ Barcode series updated to: {$startBarcode}");
            }
        }
        
        DB::commit();
        
        session()->forget($sessionKey);
        
        return response()->json([
            'status' => 'success',
            'message' => "Processing complete. Success: {$successCount}, Failed: {$failCount}",
            'data' => [
                'success_count' => $successCount,
                'fail_count' => $failCount,
                'failed_rows' => array_slice($failedRows, 0, 100),
                'created_parcel_ids' => $createdParcelIds,
                'total_amount' => round($totalPaymentAmount, 2),
                'bulk_batch_id' => $bulkBatchId
            ]
        ]);
        
    } catch (\Exception $e) {
        DB::rollBack();
        \Log::error("Transaction failed: " . $e->getMessage());
        return response()->json([
            'status' => 'error',
            'message' => 'Transaction failed: ' . $e->getMessage()
        ], 500);
    }
