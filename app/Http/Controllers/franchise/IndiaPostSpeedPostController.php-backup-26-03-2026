    \Log::info("Failures: Pickup missing={$distanceCounts['fail_pickup']}, Consignee missing={$distanceCounts['fail_consignee']}");
    \Log::info("Execution time: " . round(microtime(true) - $startTime, 2) . " seconds");
}



/**
 * Fast price calculation using pre-fetched postal rates
 */
private function fastPriceCalcForSpecial($weightInGrams, $distance, $postalRates)
{
    // Distance category mapping (optimized)
    if ($distance <= 63) {
        $distanceCategory = 'Local';
    } elseif ($distance <= 200) {
        $distanceCategory = 'upto_200_kms';
    } elseif ($distance <= 500) {
        $distanceCategory = 'rate_201_to_500_kms';
    } elseif ($distance <= 1000) {
        $distanceCategory = 'rate_501_to_1000_kms';
    } elseif ($distance <= 2000) {
        $distanceCategory = 'rate_1001_to_2000_kms';
    } else {
        $distanceCategory = 'above_2000_kms';
    }
    
    // Weight-based pricing
    if ($weightInGrams <= 50) {
        $rate = $postalRates['Up to 50 gm'] ?? null;
        $price = $rate ? ($rate->$distanceCategory ?? 0) : 0;
        $rateUsed = 'Up to 50 gm';
    } elseif ($weightInGrams <= 250) {
        $rate = $postalRates['51 to 250 gm'] ?? null;
        $price = $rate ? ($rate->$distanceCategory ?? 0) : 0;
        $rateUsed = '51 to 250 gm';
    } elseif ($weightInGrams <= 500) {
        $rate = $postalRates['251 to 500 gm'] ?? null;
        $price = $rate ? ($rate->$distanceCategory ?? 0) : 0;
        $rateUsed = '251 to 500 gm';
    } else {
        $baseRate = $postalRates['251 to 500 gm'] ?? null;
        $additionalRate = $postalRates['Additional 500 gm or part thereof'] ?? null;
        
        if ($baseRate && $additionalRate) {
            $basePrice = $baseRate->$distanceCategory ?? 0;
            $additionalWeight = $weightInGrams - 500;
            $additionalIncrements = (int)ceil($additionalWeight / 500);
            $additionalPrice = $additionalIncrements * ($additionalRate->$distanceCategory ?? 0);
            $price = $basePrice + $additionalPrice;
            $rateUsed = '251 to 500 gm + Additional';
        } else {
            $price = 0;
            $rateUsed = 'Rates not found';
        }
    }
    
    return [
        'price' => round($price, 2),
        'rate_used' => $rateUsed
    ];
}








